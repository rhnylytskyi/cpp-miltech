{
  // VS Code tasks виконуються з кореня workspace у devcontainer terminal.
  "version": "2.0.0",
  "tasks": [
    {
      // Задача за замовчуванням (Ctrl+Shift+B): тепер вона пропонує вибір між Debug та Release
      "label": "CMake: configure and build (Select Variant)",
      "type": "shell",
      "command": "cmake --preset ${input:buildVariant} && cmake --build --preset ${input:buildVariant}",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      // Окрема швидка задача суто для Debug
      "label": "CMake: build DEBUG",
      "type": "shell",
      "command": "cmake --preset debug && cmake --build --preset debug",
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      // НОВА ЗАДАЧА: Суто для Release збірки
      "label": "CMake: build RELEASE",
      "type": "shell",
      "command": "cmake --preset release && cmake --build --preset release",
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "CMake: clean build directory",
      "type": "shell",
      "command": "rm -rf build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "make quality",
      "type": "shell",
      "command": "./.devcontainer/scripts/check-quality all",
      "problemMatcher": []
    },
    {
      "label": "make format",
      "type": "shell",
      "command": "./.devcontainer/scripts/check-quality format",
      "problemMatcher": []
    },
    {
      "label": "make lint",
      "type": "shell",
      "command": "./.devcontainer/scripts/check-quality lint",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "make test",
      "type": "shell",
      "command": "./.devcontainer/scripts/check-quality test",
      "problemMatcher": []
    }
  ],
  // Інтерактивне меню для вибору типу збірки при натисканні Ctrl+Shift+B
  "inputs": [
    {
      "id": "buildVariant",
      "type": "pickString",
      "description": "Оберіть варіант збірки C++ програми:",
      "default": "debug",
      "options": [
        "debug",
        "release"
      ]
    }
  ]
}